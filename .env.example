# Where audit requests get emailed (your inbox)
LEAD_INBOX=
# Resend API key (same Resend account the dashboard uses for onboarding emails)
RESEND_API_KEY=
# Sender; the domain must be verified in Resend
LEAD_FROM=Higher Level <onboarding@higherleveladz.com>
# Your booking page (Calendly etc.) for the demo call
NEXT_PUBLIC_BOOKING_URL=
# Client dashboard login
NEXT_PUBLIC_CLIENT_LOGIN_URL=https://higher-level-dashboard.vercel.app
# Optional: Meta pixel for retargeting site visitors
NEXT_PUBLIC_META_PIXEL_ID=
